{
  "name": "main",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": ["~DEFAULT_BRANCH"],
      "exclude": []
    }
  },
  "bypass_actors": [
    {
      "actor_id": 32358850,
      "actor_type": "User",
      "bypass_mode": "always"
    }
  ],
  "rules": [
    { "type": "deletion" },
    { "type": "non_fast_forward" },
    { "type": "required_linear_history" },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": false,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": false,
        "allowed_merge_methods": ["squash"]
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "do_not_enforce_on_create": true,
        "required_status_checks": [
          { "context": "Lint", "integration_id": 15368 },
          { "context": "Format", "integration_id": 15368 },
          { "context": "Typecheck", "integration_id": 15368 },
          { "context": "Unit tests", "integration_id": 15368 },
          { "context": "Integration tests", "integration_id": 15368 },
          { "context": "E2E tests", "integration_id": 15368 },
          { "context": "Docs freshness gate", "integration_id": 15368 }
        ]
      }
    }
  ]
}
