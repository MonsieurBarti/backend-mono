# Linear API key for MCP server `barti-mono-linear`.
# Copy to `.env` in this directory (OMP loads `<cwd>/.env`).
# Create the key in Linear: Settings → Account → Security & Access.
LINEAR_API_KEY=

# Local Compose — postgres:18.6 and redis:8.8.2
POSTGRES_USER=monsieurbarti
POSTGRES_PASSWORD=monsieurbarti
POSTGRES_DB=backend_mono
POSTGRES_PORT=5432
REDIS_PORT=6379

# apps/api — schema is appEnvSchema
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://monsieurbarti:monsieurbarti@localhost:5432/backend_mono
LOG_LEVEL=info
